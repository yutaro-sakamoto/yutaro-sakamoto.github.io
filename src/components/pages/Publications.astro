---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationList from "../PublicationList.astro";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lede =
  lang === "ja"
    ? "査読付き論文・学位論文・発表の一覧です。"
    : "Peer-reviewed papers, theses and talks.";
---

<BaseLayout lang={lang} title={t("publications.title")} description={lede}>
  <div class="container container--narrow">
    <h1 class="page-title">{t("publications.title")}</h1>
    <p class="page-lede">{lede}</p>
    <div style="margin-top:2.5rem">
      <PublicationList lang={lang} />
    </div>
  </div>
</BaseLayout>
