---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { formatDate, localePath, useTranslations } from "../i18n";
import {
  getPosts,
  postLang,
  postPath,
  postSlug,
  readingTime,
  type Post,
} from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags, math } = post.data;

// 対訳記事があればそこへ、なければもう一方の言語の記事一覧へ切り替える
const otherLang = lang === "ja" ? "en" : "ja";
const translated = (await getPosts(otherLang)).find(
  (p) => postSlug(p) === postSlug(post),
);
const alternate = translated
  ? postPath(translated)
  : localePath(otherLang, "/");
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  math={math}
  type="article"
  publishedTime={pubDate}
  alternate={alternate}
  hasTranslation={translated !== undefined}
>
  <article class="container container--narrow">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-item__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time
        >
        {
          updatedDate && (
            <span>
              {t("blog.updated")}: {formatDate(updatedDate, lang)}
            </span>
          )
        }
        <span>{readingTime(post.body)} {t("blog.readingTime")}</span>
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <a class="back-link" href={localePath(lang, "/")}>
      <Icon name="arrow-left" />
      {t("blog.backToList")}
    </a>
  </article>
</BaseLayout>
